# Copy to /opt/<app>/<app>.env, mode 600, owned by root. One line per setting the app
# reads (match the prefix and names found in the project's settings class).
DATABASE_URL=postgresql+psycopg://<app>:change-me@localhost:5432/<app>
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Used by backup.sh, not by the app.
BACKUP_BUCKET=
